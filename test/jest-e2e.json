{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(\\.e2e-spec|\\.spec)\\.ts$",

  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": { "types": ["jest", "node"] } }],
    "^.+\\.(js|mjs|cjs)$": ["ts-jest", { "tsconfig": { "types": ["jest", "node"], "allowJs": true, "module": "CommonJS", "moduleResolution": "node" }, "diagnostics": false }]
  },
  "testPathIgnorePatterns": [
    "/node_modules/",
    "src/modules/auth/auth.controller.spec.ts",
    "src/modules/auth/auth.service.spec.ts",
    "src/modules/users/users.controller.spec.ts",
    "src/modules/users/users.service.spec.ts",
    "src/modules/notifications/notifications.service.spec.ts"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "collectCoverageFrom": [
    "src/**/*.(t|j)s",
    "!src/**/*.e2e-spec.ts",
    "!src/**/*.spec.ts",
    "!src/main.ts"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": ["lcov", "text-summary"]
}